# ==============================================================================
# HomeCare Web Portals — Environment Configuration Template (.env.example)
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Supabase Cloud Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Supabase Secret Key (Admin / Service Role Operations)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# HomeCare Backend API Gateway Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
